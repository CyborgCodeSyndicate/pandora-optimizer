<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.cyborgcode.utilities</groupId>
        <artifactId>parent-pom</artifactId>
        <version>0.0.0</version>
        <relativePath/>
    </parent>
    <groupId>io.cyborgcode.pandora</groupId>
    <artifactId>pandora-optimizer</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Pandora Optimizer</name>
    <description>Local language-neutral context for AI Teacher and AI Navigator.</description>
    <modules>
        <module>annotations/java</module>
        <module>engine</module>
        <module>adapters/java</module>
        <module>cli</module>
    </modules>
    <properties>
        <github.repo.name>pandora-optimizer</github.repo.name>
        <utilities.version>0.0.0</utilities.version>
        <shared-static-data.version>${utilities.version}</shared-static-data.version>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <!-- Internal dependencies follow versions:set independently of the utilities release. -->
        <pandora-optimizer.version>${project.version}</pandora-optimizer.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

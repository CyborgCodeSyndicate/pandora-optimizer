{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "sourceRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "language",
          "sourceRoots"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "uriEnv": {
            "type": [
              "string",
              "null"
            ]
          },
          "bearerTokenEnv": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxOptions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "modules"
  ],
  "additionalProperties": false
}
